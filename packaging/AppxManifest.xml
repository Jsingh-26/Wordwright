<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (docs/PLAN.md P3.6).

  Identity Name, Publisher and PublisherDisplayName are the values Partner
  Center assigned when the name was reserved (product 9PP6SR2R3FS3,
  2026-10-03); an upload is refused if any of them differ. The Store re-signs
  the package, so it is built unsigned.

  The execution alias lets "wordwright.exe" start the packaged app from a
  command line, which is how scripts/E2E runs its tests against the
  Store-installed build (docs/STORE_RELEASE_PLAN.md, Phase 3).

  The startup task is how the packaged build starts with Windows — Store policy
  forbids the HKCU Run key that the installer build uses. It starts disabled and
  the app turns it on when the user's "Start Wordwright when I sign in" setting
  says so. Description matches docs/UX_COPY.md About.Body.

  File-system write virtualisation is off (docs/PLAN.md P12.2), so the packaged
  build reads and writes the real %AppData%\Wordwright like the installer build:
  "Open data folder" shows the user's actual files, both builds share snippets,
  and uninstalling the Store app does not delete them. It needs the
  unvirtualizedResources capability below.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop4 desktop6 uap5 rescap">

  <Identity
    Name="UnboundKite.Wordwright"
    Publisher="CN=785E0A85-0C77-4BFB-8871-297326220CCD"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wordwright</DisplayName>
    <PublisherDisplayName>Unbound Kite</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- A full-trust desktop app: no sandbox, no UWP entry point. -->
    <Application Id="Wordwright" Executable="Wordwright.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wordwright"
        Description="Wordwright is free and open source (MIT). Your snippets stay on this PC."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Wordwright.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="Wordwright" Enabled="false" DisplayName="Wordwright" />
        </desktop:Extension>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="Wordwright.App.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="windows">
            <uap5:ExecutionAlias Alias="wordwright.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required by any packaged app that leaves the sandbox, which Wordwright's
         global keyboard hook and SendInput do. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by FileSystemWriteVirtualization above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
