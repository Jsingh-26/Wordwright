<Project>

  <!-- Common build settings for every project in the solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- The version the app reports on its About page. scripts/pack-release.ps1
         passes the release's version to the build, so the two always agree. -->
    <Version>0.1.2</Version>
  </PropertyGroup>

  <!-- Wordwright.Core must build with zero warnings so it stays clean and unit-testable. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wordwright.Core'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>