<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The model catalog ships inside the library, so a build can never be
         missing one (docs/ARCHITECTURE.md → Catalog, recommendation, download). -->
