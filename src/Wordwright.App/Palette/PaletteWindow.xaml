<ui:FluentWindow x:Class="Wordwright.App.Palette.PaletteWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:res="clr-namespace:Wordwright.App.Resources"
                Title="Wordwright"
                Width="360"
                SizeToContent="Height"
                WindowStyle="None"
                ResizeMode="NoResize"
                ShowInTaskbar="False"
                Topmost="True"
                ShowActivated="True"
                WindowStartupLocation="Manual"
                ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>
    <Border Padding="12">
        <StackPanel>
            <!-- Type to filter -->
            <ui:TextBox x:Name="FilterBox"
                        AutomationProperties.Name="{res:Str Palette.Filter}"
                        PlaceholderText="{res:Str Palette.Filter}"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                        PreviewKeyDown="OnFilterKeyDown" />

            <!-- The AI-off invitation, shown when AI is off and there is text to
                 rewrite. Without a selection, the palette opens on the snippet
                 list instead (docs/PLAN.md P6.8). -->
            <StackPanel x:Name="AiOffPanel" Margin="4,12,4,4" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyText}"
                           FontWeight="SemiBold"
                           Text="{res:Str Palette.AiOff.Title}" />
                <TextBlock Style="{StaticResource SecondaryText}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="{res:Str Palette.AiOff.Body}" />
                <ui:Button Appearance="Primary"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left"
                           Content="{res:Str Palette.AiOff.Button}"
                           Click="OnTurnOnAiClicked" />
            </StackPanel>

            <!-- Actions, then the snippet group (docs/DESIGN.md §6). -->
            <ListBox x:Name="ActionList"
                     Margin="0,12,0,0"
                     MaxHeight="320"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewKeyDown="OnListKeyDown"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource SelectionBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="{Binding Letter}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="{Binding Detail}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Style="{StaticResource SecondaryText}"
                       Margin="4,8,4,0"
                       Text="{res:Str Palette.Snippets.Empty}"
                       Visibility="{Binding NoSnippetsMatch, Converter={StaticResource BoolToVisibility}}" />

            <!-- Custom instruction, revealed for the custom action -->
            <StackPanel x:Name="CustomPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <ui:TextBox x:Name="CustomBox"
                            AutomationProperties.Name="{res:Str Palette.CustomPlaceholder}"
                            PlaceholderText="{res:Str Palette.CustomPlaceholder}"
                            Text="{Binding CustomInstruction, UpdateSourceTrigger=PropertyChanged}"
                            PreviewKeyDown="OnCustomKeyDown" />
            </StackPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
