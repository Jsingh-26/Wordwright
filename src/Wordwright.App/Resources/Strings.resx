  <data name="Snippets.Title" xml:space="preserve"><value>Snippets</value></data>
  <data name="Actions.Title" xml:space="preserve"><value>AI actions</value></data>
  <data name="Ai.Off.Title" xml:space="preserve"><value>Offline AI</value></data>
  <data name="Ai.Off.Body" xml:space="preserve"><value>Rewrite selected text with an AI model that runs on this PC. There's no account, no API key and no cloud. Your text never leaves this computer. Wordwright downloads the model once, only after you agree.</value></data>
  <data name="Ai.Off.Button" xml:space="preserve"><value>Turn on offline AI</value></data>
  <data name="Ai.Checking" xml:space="preserve"><value>Checking what this PC can run…</value></data>
  <data name="Ai.Rec.Title" xml:space="preserve"><value>Recommended for your PC</value></data>
