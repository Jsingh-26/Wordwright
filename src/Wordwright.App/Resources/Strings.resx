  <data name="Ai.Rec.MetaLine" xml:space="preserve"><value>{Size} download, {License} licence</value></data>
  <data name="Ai.Rec.YourPc" xml:space="preserve"><value>Your PC: {Ram} memory, {Cpu}, {GpuSummary}</value></data>
