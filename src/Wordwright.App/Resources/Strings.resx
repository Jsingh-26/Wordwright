  <data name="Ai.Rec.EstimateNote" xml:space="preserve"><value>These are estimates. Wordwright measures the real speed after downloading.</value></data>
  <data name="Ai.Rec.Privacy" xml:space="preserve"><value>After this one download, rewriting works with no internet connection.</value></data>
