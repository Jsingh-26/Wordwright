<ui:FluentWindow x:Class="Wordwright.App.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Wordwright.App.Resources"
                 Title="Wordwright"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mica needs the title bar extended, and an extended title bar needs a
             TitleBar control (the same arrangement as the main window). -->
        <ui:TitleBar Grid.Row="0" Title="Wordwright" CloseWindowByDoubleClickOnIcon="True" />

        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <TextBlock FontFamily="{StaticResource Zodiak}"
                       FontSize="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{res:Str Welcome.Title}" />
            <!-- The body quotes the snippet prefix, so it is filled in from code. -->
            <TextBlock x:Name="BodyText"
                       Style="{StaticResource BodyText}"
                       Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       Margin="0,12,0,0"
                       Text="{res:Str Welcome.AiHint}" />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,8,0"
                           Content="{res:Str Welcome.Secondary}"
                           Click="OnTurnOnAiClicked" />
                <ui:Button Appearance="Primary"
                           Content="{res:Str Welcome.Primary}"
                           Click="OnShowSnippetsClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
