<ui:FluentWindow x:Class="Wordwright.App.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Wordwright.App.Resources"
                 Title="Wordwright"
                 Icon="pack://application:,,,/Resources/icon.ico"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mica needs the title bar extended, and an extended title bar needs a
             TitleBar control (the same arrangement as the main window). -->
        <ui:TitleBar x:Name="WelcomeTitleBar" Grid.Row="0" Title="Wordwright" CloseWindowByDoubleClickOnIcon="True" />

        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <TextBlock FontFamily="{StaticResource Zodiak}"
                       FontSize="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{res:Str Welcome.Title}" />
            <!-- The body quotes the snippet prefix, so it is filled in from code. -->
            <TextBlock x:Name="BodyText"
                       Style="{StaticResource BodyText}"
                       Margin="0,12,0,0" />

            <!-- The playground (docs/PLAN.md → P3.4c): a plain text box in a
                 window Wordwright is not excluded from, so the snippet engine
                 expands in it exactly as it would in any other app. Its text is
                 never saved anywhere. -->
            <!-- The completion moment (P11.6): the check-circle sits to the left
                 of the line once a snippet has expanded here. -->
            <StackPanel x:Name="TryHereRow" Orientation="Horizontal" Margin="0,16,0,0">
                <ui:ImageIcon x:Name="TryHereCheck"
                              Width="16" Height="16"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              Source="{StaticResource IconCheckCircle}" />
                <TextBlock x:Name="TryHereLabel"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <ui:TextBox x:Name="TryHereBox"
                        Margin="0,4,0,0"
                        FontSize="14" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary"
                           Content="{res:Str Welcome.Primary}"
                           Click="OnShowSnippetsClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
