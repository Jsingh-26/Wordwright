<Page x:Class="Wordwright.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Wordwright.App.Resources">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- Grouped rows (docs/DESIGN.md §8): a heading, then one CardControl per row
         with its label left and its control right. Cards take the 6 px panel
         radius (D8) and never nest, so each is spaced by its own margin. Later
         phases add their rows inside the existing groups rather than appending
         to the page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{res:Str Settings.Title}" />

            <TextBlock Style="{StaticResource GroupHeading}"
                       Margin="0,24,0,8"
                       Text="{res:Str Settings.Group.Snippets}" />

            <!-- Snippet prefix -->
            <ui:CardControl CornerRadius="{StaticResource PanelRadius}"
                            AutomationProperties.Name="{res:Str Settings.Prefix}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Text="{res:Str Settings.Prefix}" />
                </ui:CardControl.Header>
                <ui:TextBox x:Name="PrefixBox"
                            Width="120"
                            AutomationProperties.Name="{res:Str Settings.Prefix}"
                            Text="{Binding SnippetPrefix, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>

            <!-- Apps Wordwright stays quiet in -->
            <TextBlock Style="{StaticResource BodyText}"
                       Margin="0,16,0,0"
                       Text="{res:Str Settings.ExcludedApps}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       Margin="0,2,0,0"
                       Text="{res:Str Settings.ExcludedAppsHelp}" />
            <ItemsControl ItemsSource="{Binding ExcludedApps}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The Remove button sits inside the app's own row. -->
                        <ui:CardControl Margin="0,0,0,4"
                                        CornerRadius="{StaticResource PanelRadius}"
                                        AutomationProperties.Name="{Binding}">
                            <ui:CardControl.Header>
                                <TextBlock Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center"
                                           Text="{Binding}" />
                            </ui:CardControl.Header>
                            <ui:Button Padding="10,2"
                                       Content="{res:Str Settings.ExcludedApps.Remove}"
                                       Tag="{Binding}"
                                       Click="OnRemoveExcludedAppClicked" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Margin="0,4,0,0"
                       HorizontalAlignment="Left"
                       Padding="10,4"
                       Content="{res:Str Settings.ExcludedApps.Add}"
                       Click="OnAddExcludedAppClicked" />

            <!-- Snippets in and out -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Margin="0,0,8,0"
                           Content="{res:Str Settings.Export}"
                           Click="OnExportClicked" />
                <ui:Button Content="{res:Str Settings.Import}"
                           Click="OnImportClicked" />
            </StackPanel>
            <TextBlock Margin="2,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource CautionBrush}"
                       Text="{Binding Message}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Style="{StaticResource GroupHeading}"
                       Margin="0,24,0,8"
                       Text="{res:Str Settings.Group.Wordwright}" />

            <!-- Start with Windows -->
            <ui:CardControl CornerRadius="{StaticResource PanelRadius}"
                            AutomationProperties.Name="{res:Str Settings.StartWithWindows}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Text="{res:Str Settings.StartWithWindows}" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}"
                                 AutomationProperties.Name="{res:Str Settings.StartWithWindows}" />
            </ui:CardControl>

            <!-- Theme (docs/DESIGN.md §8, decision D11). System follows Windows;
                 Light and Dark pin one theme until the user picks System again. -->
            <ui:CardControl Margin="0,8,0,0"
                            CornerRadius="{StaticResource PanelRadius}"
                            AutomationProperties.Name="{res:Str Settings.Theme}">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Text="{res:Str Settings.Theme}" />
                </ui:CardControl.Header>
                <ComboBox Width="120"
                          AutomationProperties.Name="{res:Str Settings.Theme}"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Theme, Mode=TwoWay}">
                    <ComboBoxItem Content="{res:Str Settings.Theme.System}" Tag="system" />
                    <ComboBoxItem Content="{res:Str Settings.Theme.Light}" Tag="light" />
                    <ComboBoxItem Content="{res:Str Settings.Theme.Dark}" Tag="dark" />
                </ComboBox>
            </ui:CardControl>

            <!-- Open data folder. The whole row is the button (docs/DESIGN.md §8
                 shows no separate control in it), so there is no second copy of
                 the label to read out. -->
            <ui:CardControl Margin="0,8,0,0"
                            CornerRadius="{StaticResource PanelRadius}"
                            AutomationProperties.Name="{res:Str Settings.OpenDataFolder}"
                            Click="OnOpenDataFolderClicked">
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"
                               Text="{res:Str Settings.OpenDataFolder}" />
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
