<Page x:Class="Wordwright.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Wordwright.App.Resources">
    <StackPanel Margin="32,24" MaxWidth="560">
        <TextBlock Style="{StaticResource PageTitle}" Text="{res:Str Settings.Title}" />
        <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                         Content="{res:Str Settings.StartWithWindows}"
                         Margin="0,16,0,0"
                         Checked="OnStartWithWindowsChanged"
                         Unchecked="OnStartWithWindowsChanged" />
    </StackPanel>
</Page>