<Page x:Class="Wordwright.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Wordwright.App.Resources"
      ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll="False" keeps WPF-UI's page scroller off (it copies this
         value into IsDynamicScrollViewerEnabled on navigation), so
         the page is measured at the window's height and its own ScrollViewer
         scrolls (P10.2: at 800x600 nothing scrolled). -->
    <!-- docs/DESIGN.md §9, with the hero illustration (P10.0) above the title. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="560" HorizontalAlignment="Left">
            <!-- Decorative: the title below says what the page is. -->
            <Image Source="{DynamicResource HeroImage}" MaxWidth="320"
                   HorizontalAlignment="Left" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource PageTitle}" Text="Wordwright" />
            <TextBlock Style="{StaticResource BodyText}" Text="{res:Str About.Publisher}" />
            <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0"
                       Text="{res:Str About.Body}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                       Text="{res:Str About.Privacy}" />

            <!-- The link wears the brand accent, not the system blue
                 (docs/DESIGN.md §9, AGENTS.md rule 7). -->
            <TextBlock Margin="0,12,0,0">
                <Hyperlink NavigateUri="https://github.com/Jsingh-26/Wordwright"
                           Foreground="{DynamicResource BrandAccentBrush}"
                           RequestNavigate="OnSourceLinkClicked">
                    <Run Text="{res:Str About.Source}" />
                </Hyperlink>
            </TextBlock>

            <ui:CardExpander Margin="0,20,0,0"
                             CornerRadius="{StaticResource PanelRadius}"
                             Header="{res:Str About.ThirdParty}"
                             AutomationProperties.Name="{res:Str About.ThirdParty}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.Zodiak}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.Phosphor}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.WpfUi}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.NotifyIcon}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.Velopack}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="{res:Str About.Licence.Mvvm}" />
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
