<Page x:Class="Wordwright.App.Pages.AiActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Wordwright.App.Resources"
      xmlns:controls="clr-namespace:Wordwright.App.Controls">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- The same row style the Snippets list uses (docs/DESIGN.md §2). -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page title, the quiet "Saved", and the primary action. -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="{res:Str Actions.Title}" />
                <TextBlock Style="{StaticResource SecondaryText}"
                           Margin="12,0,0,4"
                           VerticalAlignment="Bottom"
                           Text="{res:Str Snippets.Saved}"
                           Visibility="{Binding ShowSaved, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ui:Button Appearance="Primary"
                       Content="{res:Str Actions.New}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Click="OnNewActionClicked" />
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Actions}"
                     SelectedItem="{Binding SelectedAction}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Letter}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The editor -->
            <ScrollViewer Grid.Column="1"
                          Margin="24,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <Grid IsEnabled="{Binding HasSelection}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Actions.Field.Name}" />
                        <ui:TextBox x:Name="NameBox"
                                    Margin="0,4,0,0"
                                    AutomationProperties.Name="{res:Str Actions.Field.Name}"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Actions.Field.Letter}" />
                        <ui:TextBox x:Name="LetterBox"
                                    Width="80"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    MaxLength="1"
                                    AutomationProperties.Name="{res:Str Actions.Field.Letter}"
                                    Text="{Binding Letter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- The hotkey recorder: click, press the keys, see them. -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Actions.Field.Hotkey}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <controls:HotkeyRecorder x:Name="HotkeyBox"
                                                     MinWidth="180"
                                                     HorizontalAlignment="Left"
                                                     AutomationProperties.Name="{res:Str Actions.Field.Hotkey}"
                                                     Hotkey="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Margin="8,0,0,0"
                                       Content="{res:Str Actions.Hotkey.Clear}"
                                       Click="OnClearHotkeyClicked" />
                        </StackPanel>
                        <TextBlock Margin="2,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CautionBrush}"
                                   Text="{Binding HotkeyMessage}"
                                   Visibility="{Binding HasHotkeyMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Margin="2,4,0,0"
                                   Text="{res:Str Actions.Field.HotkeyHelp}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Actions.Field.Instruction}" />
                        <ui:TextBox x:Name="InstructionBox"
                                    Margin="0,4,0,0"
                                    MinHeight="120"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    VerticalScrollBarVisibility="Auto"
                                    AutomationProperties.Name="{res:Str Actions.Field.Instruction}"
                                    Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Margin="2,4,0,0"
                                   Text="{res:Str Actions.Field.InstructionHelp}" />
                    </StackPanel>

                    <!-- Try it: runs this action over text pasted here, in place. -->
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Actions.TryIt}" />
                        <ui:TextBox x:Name="TryItBox"
                                    Margin="0,4,0,0"
                                    MinHeight="72"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"
                                    VerticalScrollBarVisibility="Auto"
                                    AutomationProperties.Name="{res:Str Actions.TryIt}"
                                    PlaceholderText="{res:Str Actions.TryItPlaceholder}"
                                    Text="{Binding TryItText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Appearance="Primary"
                                       Margin="0,0,8,0"
                                       Content="{res:Str Actions.TryIt}"
                                       IsEnabled="{Binding CanTryIt}"
                                       Click="OnTryItClicked" />
                            <ui:Button Content="{res:Str Actions.ResetBuiltIn}"
                                       Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}"
                                       Click="OnResetClicked" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Margin="2,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding TryItHint}"
                                   Visibility="{Binding HasTryItHint, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="2,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CautionBrush}"
                                   Text="{Binding TryItMessage}"
                                   Visibility="{Binding HasTryItMessage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
