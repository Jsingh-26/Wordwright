<Page x:Class="Wordwright.App.Pages.SnippetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:Wordwright.App.Resources"
      xmlns:core="clr-namespace:Wordwright.Core.Snippets;assembly=Wordwright.Core"
      ScrollViewer.CanContentScroll="False">
    <!-- CanContentScroll="False" keeps WPF-UI's page scroller off (it copies this
         value into IsDynamicScrollViewerEnabled on navigation), so
         the page is measured at the window's height and its own ScrollViewer
         scrolls (P10.2: at 800x600 nothing scrolled). -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- The shortcut reads as a chip (docs/DESIGN.md, decision D7): a small
             tactile object for the connected animation to carry into the editor. -->
        <Style x:Key="ShortcutChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- WPF-UI has no list control, so the rows are styled here to match the
             rail: accent tint for the chosen row, no white system highlight. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="{StaticResource PanelRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page title, the quiet "Saved", and the primary action. -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="{res:Str Snippets.Title}" />
                <!-- Faded in and out by the page (docs/PLAN.md → P11.5); the
                     base opacity is 0 and Motion leaves it at the right value. -->
                <TextBlock x:Name="SavedText"
                           Style="{StaticResource SecondaryText}"
                           Margin="12,0,0,4"
                           VerticalAlignment="Bottom"
                           Opacity="0"
                           Text="{res:Str Snippets.Saved}" />
            </StackPanel>
            <ui:Button Appearance="Primary"
                       Content="{res:Str Snippets.New}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Click="OnNewSnippetClicked" />
        </Grid>

        <Grid Grid.Row="1" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list -->
            <DockPanel Grid.Column="0">
                <ui:TextBox x:Name="SearchBox"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="{res:Str Snippets.Search}"
                            PlaceholderText="{res:Str Snippets.Search}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource SecondaryText}"
                           Margin="2,0,2,0"
                           Text="{Binding EmptyMessage}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <!-- The empty state invites a try right here, through the same
                     snippet engine that works in other apps (docs/PLAN.md → P3.4c). -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,12,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <!-- The completion moment (P11.6): the check-circle joins the
                         line once a snippet has expanded in the box below. -->
                    <StackPanel x:Name="EmptyTryHereRow" Orientation="Horizontal">
                        <ui:ImageIcon x:Name="EmptyTryHereCheck"
                                      Width="16" Height="16"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Source="{StaticResource IconCheckCircle}" />
                        <TextBlock x:Name="EmptyTryHereLabel"
                                   Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyTryHere}" />
                    </StackPanel>
                    <ui:TextBox x:Name="TryHereBox"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="{Binding EmptyTryHere}" />
                </StackPanel>
                <ListBox x:Name="SnippetList"
                         ItemsSource="{Binding Snippets}"
                         SelectedItem="{Binding SelectedSnippet}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnSelectionChanged"
                         PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                         PreviewMouseLeftButtonUp="OnListPreviewMouseUp"
                         PreviewKeyDown="OnListPreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <Border Style="{StaticResource ShortcutChip}" Tag="ShortcutChip">
                                    <TextBlock FontFamily="{StaticResource AppText}"
                                               FontSize="12"
                                               Text="{Binding Shortcut}" />
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,3,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The editor. It scrolls when the window is too short for it
                 (800x600, P10.2); held at least as tall as the view, so on a
                 larger window the text box still takes the spare height. -->
            <ScrollViewer x:Name="EditorScroller"
                          Grid.Column="1"
                          Margin="24,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
            <!-- The 12 px on the right keeps the scroll bar off the fields. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=EditorScroller}"
                  Margin="0,0,12,0"
                  IsEnabled="{Binding HasSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="NameGroup" Grid.Row="0">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Snippets.Field.Name}" />
                    <ui:TextBox x:Name="NameBox"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="{res:Str Snippets.Field.Name}"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel x:Name="ShortcutGroup" Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Snippets.Field.Shortcut}" />
                    <Grid x:Name="ShortcutField" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Prefix}" />
                        <ui:TextBox Grid.Column="1"
                                    Margin="4,0,0,0"
                                    AutomationProperties.Name="{res:Str Snippets.Field.Shortcut}"
                                    Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Margin="2,4,0,0"
                               Text="{Binding ShortcutHelp}" />
                    <TextBlock Margin="2,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ShortcutMessage}"
                               Visibility="{Binding HasShortcutMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                <Style.Triggers>
                                    <!-- D9: true errors read as errors; cautions ("very long…")
                                         stay Ochre. SystemFillColorCriticalBrush is WPF-UI's
                                         theme-following critical fill. -->
                                    <DataTrigger Binding="{Binding ShortcutMessageIsError}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="BodyGroup" Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{res:Str Snippets.Field.Text}" />
                    <ui:TextBox x:Name="BodyBox"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="{res:Str Snippets.Field.Text}"
                                MinHeight="180"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Live preview of what the body will insert, with today's
                         date and time resolved (docs/PLAN.md → P3.4c). -->
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Margin="2,8,0,0"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{res:Str Snippets.Preview}" />
                        <Run Text="{Binding Preview}" />
                    </TextBlock>
                    <!-- Insert a variable where the caret is (docs/DESIGN.md §2). Wraps
                         so a narrow window (800x600) does not clip the buttons; the
                         6 px under each button is the gap between wrapped rows. -->
                    <WrapPanel Margin="0,8,0,-6">
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,6"
                                   Text="{res:Str Snippets.Insert}" />
                        <ui:Button Margin="0,0,6,6" Padding="10,4"
                                   Content="{res:Str Snippets.Insert.Date}"
                                   Tag="{x:Static core:SnippetVariables.Date}"
                                   Click="OnInsertClicked" />
                        <ui:Button Margin="0,0,6,6" Padding="10,4"
                                   Content="{res:Str Snippets.Insert.Time}"
                                   Tag="{x:Static core:SnippetVariables.Time}"
                                   Click="OnInsertClicked" />
                        <ui:Button Margin="0,0,6,6" Padding="10,4"
                                   Content="{res:Str Snippets.Insert.Clipboard}"
                                   Tag="{x:Static core:SnippetVariables.Clipboard}"
                                   Click="OnInsertClicked" />
                        <ui:Button Margin="0,0,0,6" Padding="10,4"
                                   Content="{res:Str Snippets.Insert.Cursor}"
                                   Tag="{x:Static core:SnippetVariables.Cursor}"
                                   Click="OnInsertClicked" />
                    </WrapPanel>
                    <TextBlock Margin="2,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CautionBrush}"
                               Text="{Binding BodyMessage}"
                               Visibility="{Binding HasBodyMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ui:Button Grid.Row="3"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Left"
                           Content="{res:Str Snippets.Delete}"
                           Click="OnDeleteSnippetClicked" />
            </Grid>
            </ScrollViewer>
        </Grid>

        <!-- The connected animation's proxy floats here, above the page, so it
             never takes a hit or a measure from the list (docs/PLAN.md → P11.5). -->
        <Canvas x:Name="Overlay"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                IsHitTestVisible="False"
                ClipToBounds="True" />
    </Grid>
</Page>