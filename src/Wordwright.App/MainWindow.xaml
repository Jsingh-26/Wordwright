<ui:FluentWindow x:Class="Wordwright.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Wordwright.App.Resources"
                 xmlns:pages="clr-namespace:Wordwright.App.Pages"
                 Title="Wordwright"
                 Height="720" Width="1040"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <ui:NavigationView x:Name="RootNavigation"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="240">
            <ui:NavigationView.PaneHeader>
                <!-- Wordmark (DESIGN.md: Zodiak, the mark at cap height, accent colour). -->
                <StackPanel Orientation="Horizontal" Margin="16,4,16,16">
                    <Path Data="{StaticResource WordwrightMarkGeometry}"
                          Fill="{DynamicResource SystemAccentColorBrush}"
                          Stretch="Uniform" Width="22" Height="22"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Wordwright"
                               FontFamily="{StaticResource Zodiak}"
                               FontSize="32"
                               Foreground="{DynamicResource SystemAccentColorBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{res:Str Nav.Snippets}" TargetPageType="{x:Type pages:SnippetsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="{StaticResource IconKeyboard}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.Actions}" TargetPageType="{x:Type pages:AiActionsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="{StaticResource IconMagicWand}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.OfflineAi}" TargetPageType="{x:Type pages:OfflineAiPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="{StaticResource IconCpu}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="{StaticResource IconGear}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.About}" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="{StaticResource IconInfo}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.ContentOverlay>
                <ui:TitleBar Title="Wordwright" Grid.Row="0" />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>