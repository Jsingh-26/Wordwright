<ui:FluentWindow x:Class="Wordwright.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Wordwright.App.Resources"
                 xmlns:pages="clr-namespace:Wordwright.App.Pages"
                 Title="Wordwright"
                 Icon="pack://application:,,,/Resources/icon.ico"
                 Height="720" Width="1040"
                 MinWidth="800" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <!-- The window's accelerators (docs/DESIGN.md §2): a new snippet, the search
         box, and deleting the selected snippet. They live on the window, not on
         the page, so they also work while the focus is on the navigation rail.
         A text box handles Delete itself, so typing in a field is unaffected. -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="New" Modifiers="Control" Key="N" />
        <KeyBinding Command="Find" Modifiers="Control" Key="F" />
        <KeyBinding Command="Delete" Key="Delete" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="New" Executed="OnNewSnippetCommand" />
        <CommandBinding Command="Find" Executed="OnFindCommand" />
        <CommandBinding Command="Delete" Executed="OnDeleteSnippetCommand" />
    </ui:FluentWindow.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar gets its own row (the arrangement WPF-UI's own project
             template uses); nesting it in NavigationView.ContentOverlay pushes the
             window buttons past the window's right edge. -->
        <!-- Named so the window can find its template buttons and give them
             automation names (docs/UX_COPY.md → Accessibility). -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Title="Wordwright"
                     CloseWindowByDoubleClickOnIcon="True" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="240">
            <ui:NavigationView.PaneHeader>
                <!-- Wordmark (DESIGN.md: the mark at cap height, Zodiak, accent
                     colour, wrapped over two lines as in the DESIGN.md sketch). -->
                <StackPanel Orientation="Horizontal" Margin="16,4,16,16">
                    <Path Data="{StaticResource WordwrightMarkGeometry}"
                          Fill="{DynamicResource BrandAccentBrush}"
                          Stretch="Uniform" Width="22" Height="22"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock FontFamily="{StaticResource Zodiak}"
                               FontSize="32"
                               LineHeight="34"
                               Foreground="{DynamicResource BrandAccentBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Word" /><LineBreak /><Run Text="wright" />
                    </TextBlock>
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{res:Str Nav.Snippets}" TargetPageType="{x:Type pages:SnippetsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Width="16" Height="16" Source="{StaticResource IconKeyboard}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Width="16" Height="16" Source="{StaticResource IconGear}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{res:Str Nav.About}" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Width="16" Height="16" Source="{StaticResource IconInfo}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- WPF-UI allows one dialog host per window ("attempting to register
             multiple instances will result in an exception"). It lives here, not
             on a page: a page is created again whenever the user navigates back
             to it, and the second host would take the app down. -->
        <ui:ContentDialogHost Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>