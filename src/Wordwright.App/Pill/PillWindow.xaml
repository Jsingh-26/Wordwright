<Window x:Class="Wordwright.App.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pill="clr-namespace:Wordwright.App.Pill"
        xmlns:res="clr-namespace:Wordwright.App.Resources"
        Title="Wordwright"
        Height="32"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border CornerRadius="16"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="12,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource EmberBrush}" />
                <Path x:Name="Glyph"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="Message"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="{res:Str Pill.Working}" />
            <TextBlock x:Name="Cancel"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{res:Str Pill.Cancel}" />
            <pill:RulerTick x:Name="Ruler"
                            Width="120"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{res:Str Pill.Ruler.Name}" />
        </StackPanel>
    </Border>
</Window>
