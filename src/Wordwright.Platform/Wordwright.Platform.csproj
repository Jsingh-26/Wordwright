<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- For the clipboard's OLE data object: saving and restoring every format
         the previous clipboard owner will hand over. Wordwright.Core stays free
         of UI frameworks; this layer is the Windows glue. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wordwright.Core\Wordwright.Core.csproj" />
  </ItemGroup>

</Project>