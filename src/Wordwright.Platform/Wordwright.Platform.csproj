<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- For the clipboard's OLE data object: saving and restoring every format
         the previous clipboard owner will hand over. Wordwright.Core stays free
         of UI frameworks; this layer is the Windows glue. -->
