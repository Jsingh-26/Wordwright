<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end runner (docs/E2E.md), not part of the solution and never shipped.
    Starts the real Wordwright build in end-to-end test mode (WORDWRIGHT_E2E_DATA:
    a scratch data folder, its own single-instance names, the Run key never
    touched), then drives it through UI Automation and tagged SendInput: the
    welcome playground, the window, the tray menu, and expansion in real apps.
    Writes a report with screenshots to scripts/e2e-results/<time>/.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wordwright.Platform\Wordwright.Platform.csproj" />
    <!-- Microsoft's accessibility engine behind Accessibility Insights (MIT). Test-only. -->
    <PackageReference Include="Axe.Windows" />
  </ItemGroup>

</Project>
