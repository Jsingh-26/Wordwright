<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-only integration harness for ClipboardService and InputSender, not part
    of the solution and never shipped. It opens a window with a text box, sends
    the real keystrokes Wordwright sends, and checks what landed in the box: the
    paste, the backspaces and the Left arrows, plus what the clipboard looks like
    during and after the swap. It saves the maintainer's clipboard text first and
    puts it back at the end.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>PasteHarness.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wordwright.Platform\Wordwright.Platform.csproj" />
  </ItemGroup>

</Project>
